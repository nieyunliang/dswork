{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dswork",
  "version": "0.1.1",
  "identifier": "com.yunliang.dswork",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dswork",
        "width": 1200,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MzQ1MzM0MTcxRTlGQ0UKUldUT254NFhORk0wcVlkQVg3ZEF0UldnWFlmcTltSU5KYngxOGNFQWlkMHBvQ1JVdWw5a2xaZW8K",
      "endpoints": [
        "https://github.com/nieyunliang/dswork/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
